# Copiar a .env (no versionado) y ajustar.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=core
DB_USERNAME=core
DB_PASSWORD=change-me
DB_POOL_SIZE=20

# Seguridad (JWT_SECRET >= 32 caracteres: openssl rand -base64 48)
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@core.local
ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=false

# Redis (caché, revocación de tokens, rate limit de login, locks)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Observabilidad
TRACING_ENABLED=false
TRACING_SAMPLING=0.1
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces

# Mensajería: none | kafka | rabbit
MESSAGING_PROVIDER=none
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBIT_HEALTH_ENABLED=false

# Archivos: none | local | s3
STORAGE_PROVIDER=none
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=core
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
